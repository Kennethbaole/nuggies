# Copy to .env (git-ignored). The backend and scripts load it automatically;
# variables already set in the shell win. Never put keys in JS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional local JSON profile; voice_id/model/settings override the above.
VOICE_PROFILE_PATH=
SPEECH_CACHE_DIR=.cache/tts
# Required when backend.app binds beyond localhost. Enter this token in each UI.
APP_TOKEN=
# Reply suggestions from what the other person says, written on the device by a
# local Qwen model through Ollama. Set OLLAMA_MODEL to enable them, e.g.
# qwen3:1.7b (installed by scripts/setup_jetson.sh; it leaves room for speech-to-text
# in the Jetson's 8 GB, where qwen3.5:4b nearly fills memory). Hears speech through ASR_URL.
# OLLAMA_URL can point at another machine running Ollama, such as a laptop.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# single: one request writes all five replies as JSON. parallel: five one-reply
# requests at once, much faster on the Jetson when its Ollama runs with
# OLLAMA_NUM_PARALLEL=5 (otherwise they queue and gain little).
OLLAMA_MODE=single
# How long the model stays loaded after a request (overrides the server's setting).
# -1 keeps it loaded until Ollama restarts; a cold load takes ~20 s on the Jetson.
OLLAMA_KEEP_ALIVE=30m
# Speech-to-text: Qwen3-ASR on the Jetson (backend.asr_server). The browser mic
# records here; the app sends the audio to ASR_URL and uses the transcript for
# replies. Through an SSH tunnel (ssh -N -L 8000:127.0.0.1:8000 user@jetson)
# use http://127.0.0.1:8000; over Tailscale use http://<jetson-tailscale-ip>:8000.
# Listening needs only this; the reply model never receives audio, only the
# transcript. Unset: the Listen button is off and typed text still works.
ASR_URL=
# Must match ASR_TOKEN on the Jetson when the service binds beyond localhost.
ASR_TOKEN=
ASR_TIMEOUT_S=10
# Jetson side only (backend.asr_server): model, device and optional fixed language.
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_DEVICE=cuda:0
ASR_LANGUAGE=
