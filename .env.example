# Copy to .env (git-ignored). The backend and scripts load it automatically;
# variables already set in the shell win. Never put keys in JS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional local JSON profile; voice_id/model/settings override the above.
VOICE_PROFILE_PATH=
SPEECH_CACHE_DIR=.cache/tts
# Required when backend.app binds beyond localhost. Enter this token in each UI.
APP_TOKEN=
# Reply suggestions from what the other person says (Google AI Studio key).
GEMINI_API_KEY=
# Optional. Default gemini-3.8-flash; try gemini-3.5-flash-lite for lower latency.
GEMINI_MODEL=
# Offline fallback: a local Ollama model answers when Gemini fails or takes longer
# than SUGGEST_DEADLINE_S (default 2). Set OLLAMA_MODEL to enable it, e.g.
# llama3.2:3b (installed by scripts/setup_jetson.sh). Hears speech through ASR_URL.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
SUGGEST_DEADLINE_S=2
# Speech-to-text: Qwen3-ASR on the Jetson (backend.asr_server). The browser mic
# records here; the app sends the audio to ASR_URL and uses the transcript for
# replies. Through an SSH tunnel (ssh -N -L 8000:127.0.0.1:8000 user@jetson)
# use http://127.0.0.1:8000; over Tailscale use http://<jetson-tailscale-ip>:8000.
# Listening needs only this; Gemini/Ollama never receive audio, only the
# transcript. Unset: the Listen button is off and typed text still works.
ASR_URL=
# Must match ASR_TOKEN on the Jetson when the service binds beyond localhost.
ASR_TOKEN=
ASR_TIMEOUT_S=10
# Jetson side only (backend.asr_server): model, device and optional fixed language.
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_DEVICE=cuda:0
ASR_LANGUAGE=
