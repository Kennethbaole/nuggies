# Copy to .env (git-ignored). The backend and scripts load it automatically;
# variables already set in the shell win. Never put keys in JS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional local JSON profile; voice_id/model/settings override the above.
VOICE_PROFILE_PATH=
SPEECH_CACHE_DIR=.cache/tts
# Required when backend.app binds beyond localhost. Enter this token in each UI.
APP_TOKEN=
# Reply suggestions from what the other person says, written on the Jetson by a
# local Qwen model through Ollama (installed by scripts/setup_jetson.sh).
# Try qwen3.5:2b for faster replies. Typed text only until speech-to-text is wired in.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
