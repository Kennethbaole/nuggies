# Export these in the shell before starting backend.app. Never put keys in JS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional local JSON profile; voice_id/model/settings override the above.
VOICE_PROFILE_PATH=
SPEECH_CACHE_DIR=.cache/tts
# Required when backend.app binds beyond localhost. Enter this token in each UI.
APP_TOKEN=
