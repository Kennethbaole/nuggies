# Copy to .env (git-ignored). The backend and scripts load it automatically;
# variables already set in the shell win. Never put keys in JS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional local JSON profile; voice_id/model/settings override the above.
VOICE_PROFILE_PATH=
SPEECH_CACHE_DIR=.cache/tts
# Required when backend.app binds beyond localhost. Enter this token in each UI.
APP_TOKEN=
# Reply suggestions from what the other person says (Google AI Studio key).
GEMINI_API_KEY=
# Optional. Default gemini-3.8-flash; try gemini-3.5-flash-lite for lower latency.
GEMINI_MODEL=
# Offline fallback: a local Ollama model answers when Gemini fails or takes longer
# than SUGGEST_DEADLINE_S (default 2). Set OLLAMA_MODEL to enable it, e.g.
# llama3.2:3b (installed by scripts/setup_jetson.sh). Typed text only for now.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
SUGGEST_DEADLINE_S=2
